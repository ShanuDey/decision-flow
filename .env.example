# cp .env.example .env
# Only what you must set is here. Every optional setting has a default that suits a normal
# self-hosted install; see docs/configuration.md for the full list.

# ---- Shared: read by both the API and the web app ----
# the Postgres container reads POSTGRES_PASSWORD, the API and web read DATABASE_URL: one password, keep both in step
POSTGRES_PASSWORD=decisionflow
DATABASE_URL=postgresql+psycopg://decisionflow:decisionflow@localhost:5432/decisionflow

# ---- API only ----
CORS_ORIGINS=http://localhost:3000

# traces go to DATABASE_URL (schema `mlflow`); set MLFLOW_TRACKING_URI to send them elsewhere
# MLFLOW_TRACKING_URI=http://mlflow.example:5000
MLFLOW_SET_EXPERIMENT=decision-flow

# /docs, /redoc and /openapi.json list every endpoint: set true for local work only
# API_DOCS_ENABLED=true

# ---- Web only (login) ----
# Auth is always on. `make start` runs `make auth-setup` once, which appends to your .env:
#   web: BETTER_AUTH_SECRET, AUTH_SIGNING_KEY (private key), API_URL, AUTH_ADMIN_EMAIL / AUTH_ADMIN_PASSWORD
#   api: AUTH_PROVIDERS (the matching public key)
# Never commit or share those values. Login methods, allowed domains and the rest: docs/auth.md.
