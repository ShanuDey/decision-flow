# cp .env.example .env
POSTGRES_PASSWORD=decisionflow
CORS_ORIGINS=http://localhost:3000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_SET_EXPERIMENT=decision-flow
# largest accepted request body in bytes (default 1 MiB)
# MAX_REQUEST_BYTES=1048576
# password must match POSTGRES_PASSWORD (URL-encode special characters)
DATABASE_URL=postgresql+psycopg://decisionflow:decisionflow@localhost:5432/decisionflow
# used by `make mlflow-ui` (same rule as DATABASE_URL)
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://decisionflow:decisionflow@localhost:5432/mlflow
