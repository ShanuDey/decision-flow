# cp .env.example .env
# the Postgres container reads POSTGRES_PASSWORD, the API reads DATABASE_URL: one password, keep both in step
POSTGRES_PASSWORD=decisionflow
DATABASE_URL=postgresql+psycopg://decisionflow:decisionflow@localhost:5432/decisionflow
CORS_ORIGINS=http://localhost:3000
# traces go to DATABASE_URL (schema `mlflow`); set MLFLOW_TRACKING_URI to send them elsewhere
# MLFLOW_TRACKING_URI=http://mlflow.example:5000
MLFLOW_SET_EXPERIMENT=decision-flow
# limits (docs/limits.md); 0 turns one off, except MAX_REQUEST_BYTES (largest request body in bytes)
# MAX_REQUEST_BYTES=1048576
# MAX_CONCURRENT_RUNS=10
# MAX_CONCURRENT_RUNS_PER_WORKSPACE=0
# RUN_TIMEOUT_SECONDS=300
# MAX_NODES=50
# MAX_EDGES=100
# MAX_FLOWS_PER_USER=20
# rate limits (docs/limits.md); per minute unless noted, 0 turns one off
# RATE_LIMIT_IP_PER_MINUTE=120
# RATE_LIMIT_READY_PER_MINUTE=6
# RATE_LIMIT_FAILED_AUTH_PER_MINUTE=10
# RATE_LIMIT_USER_WRITES_PER_MINUTE=60
# RATE_LIMIT_USER_RUNS_PER_MINUTE=20
# RATE_LIMIT_NEW_WORKSPACES_PER_IP_PER_HOUR=5
# proxies in front of the API whose X-Forwarded-For entry is trusted (1 on Render); 0 ignores the header
# TRUSTED_PROXY=0
# retention (docs/retention.md); 0 keeps everything, the timer runs only if one is set
# RUN_RETENTION_DAYS=0
# USER_RETENTION_DAYS=0
# RETENTION_INTERVAL_MINUTES=60
# accounts that are never deleted, comma separated
# RETENTION_KEEP_EMAILS=
# log what would be deleted without deleting
# RETENTION_DRY_RUN=false
# text (and an optional http(s) link) added to every limit error, for a shared public deployment
# LIMIT_NOTICE=This is a free demo on shared resources. To get more capacity, self-host it or sponsor the server.
# LIMIT_NOTICE_URL=https://github.com/sponsors/ShanuDey

# Auth is always on. `make start` runs `make auth-setup` once, which appends to your .env:
# AUTH_PROVIDERS + AUTH_SIGNING_KEY (a local key pair), BETTER_AUTH_SECRET, API_URL
# and a local admin (AUTH_ADMIN_EMAIL / AUTH_ADMIN_PASSWORD).
# Never commit or share those values. See docs/auth.md.
# AUTH_PROVIDERS is a JSON list of the token issuers the API trusts.
# AUTH_PROVIDERS=
# optional: only verified emails from these domains may sign in
# AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# Web sign-in (Better Auth). AUTH_METHODS lists the login methods, comma-separated; unset means password.
# For each social method NAME, set the options its Better Auth docs ask for as NAME_<OPTION>, usually
# NAME_CLIENT_ID and NAME_CLIENT_SECRET (redirect URL <BETTER_AUTH_URL>/api/auth/callback/<name>).
# Nothing is checked at start: a bad setup shows in the web server log when its button is clicked.
# AUTH_METHODS=password
# public URL of the web app (also the token issuer unless AUTH_TOKEN_ISSUER is set)
# BETTER_AUTH_URL=http://localhost:3000
# server-only URL the web server uses to reach the API (never sent to browsers)
# API_URL=http://localhost:8000
# set false to run the auth-schema migration yourself (make auth-migrate) instead of at web start
# AUTH_AUTO_MIGRATE=false
# password login needs an account: set both to create an admin at start when no user exists
# AUTH_ADMIN_EMAIL=
# AUTH_ADMIN_PASSWORD=
# extra origins allowed to make write requests (for example a preview URL)
# AUTH_TRUSTED_ORIGINS=
# header your proxy sets with the real client IP (default x-forwarded-for); used for sign-in rate limits.
# Only list one that your proxy overwrites, or clients can fake it. AUTH_TRUSTED_PROXIES lists proxy IPs/CIDRs.
# AUTH_IP_HEADER=
# AUTH_TRUSTED_PROXIES=

# /docs, /redoc and /openapi.json list every endpoint: set true for local work only
# API_DOCS_ENABLED=true
