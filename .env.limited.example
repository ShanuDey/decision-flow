# Every limit on, hard delete, short retention: for a shared or public deployment such as the demo.
# Paste these into your host's environment (most hosts have an "add from .env" option), or append them to .env.
# They override the defaults in the code, which suit a normal self-hosted install (docs/limits.md).
# No secrets belong here: DATABASE_URL, AUTH_PROVIDERS, AUTH_SIGNING_KEY, BETTER_AUTH_SECRET and the
# rest of .env.example stay in the platform's own settings.
# Everything below is API only: the web app gets what it shows (delete mode, limit notice) from the API.
DELETE_MODE=hard
MAX_CONCURRENT_RUNS=10
MAX_CONCURRENT_RUNS_PER_WORKSPACE=2
RUN_TIMEOUT_SECONDS=30
MAX_NODES=50
MAX_EDGES=100
MAX_FLOWS_PER_USER=20
MAX_VERSIONS_PER_FLOW=10
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_READY_PER_MINUTE=6
RATE_LIMIT_FAILED_AUTH_PER_MINUTE=10
RATE_LIMIT_USER_WRITES_PER_MINUTE=60
RATE_LIMIT_USER_RUNS_PER_MINUTE=20
RATE_LIMIT_NEW_WORKSPACES_PER_IP_PER_HOUR=5
# Proxies in front of the API: 1 behind a typical platform load balancer, 0 if none (or a client can fake its IP)
TRUSTED_PROXY=1
RUN_RETENTION_DAYS=7
USER_RETENTION_DAYS=7
LIMIT_NOTICE=This is a free demo on shared resources. To get more capacity, self-host it or sponsor the server.
LIMIT_NOTICE_URL=https://github.com/sponsors/ShanuDey
