{
  "schema_version": 1,
  "id": "openai_compatible",
  "name": "OpenAI-compatible",
  "description": "OpenAI or any provider with an OpenAI-style API. Set the base URL to the provider's.",
  "icon": "sparkles",
  "docs_url": "https://platform.openai.com/docs/api-reference/authentication",
  "category": "builtin",
  "fields": [
    {
      "name": "api_key",
      "label": "API key",
      "secret": true
    },
    {
      "name": "base_url",
      "label": "Base URL",
      "format": "url",
      "default": "https://api.openai.com/v1",
      "placeholder": "https://api.openai.com/v1",
      "help": "Your key is only ever sent to this URL's host."
    }
  ],
  "auth": {
    "kind": "bearer",
    "token": "api_key"
  },
  "hosts_from": "base_url",
  "test_path": "/models"
}
