{
  "$defs": {
    "HttpRequestData": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "default": null,
          "title": "Body"
        },
        "body_type": {
          "default": "none",
          "enum": [
            "none",
            "json",
            "form",
            "text"
          ],
          "title": "Body Type",
          "type": "string"
        },
        "connection_id": {
          "default": "",
          "title": "Connection Id",
          "type": "string"
        },
        "fail_on_error_status": {
          "default": false,
          "title": "Fail On Error Status",
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Query",
          "type": "object"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        }
      },
      "title": "HttpRequestData",
      "type": "object"
    },
    "TemplateConnection": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "TemplateConnection",
      "type": "object"
    },
    "TemplateInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "TemplateInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "connection": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemplateConnection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data": {
      "$ref": "#/$defs/HttpRequestData"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "docs_url": {
      "default": "",
      "title": "Docs Url",
      "type": "string"
    },
    "icon": {
      "default": "plug",
      "title": "Icon",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/TemplateInput"
      },
      "title": "Inputs",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "node_type": {
      "const": "http_request",
      "title": "Node Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secrets": {
      "items": {
        "type": "string"
      },
      "title": "Secrets",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "node_type",
    "data"
  ],
  "title": "NodeTemplate",
  "type": "object"
}
