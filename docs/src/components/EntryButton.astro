---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a class="entry-button" href={`${base}/open?to=home`} target="_top">Get started</a>

<style>
  .entry-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    min-width: 6rem;
    padding: 0 1rem;
    border-radius: 0.5rem;
    background: #fb7185;
    color: #0b1220;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .entry-button:hover {
    filter: brightness(1.08);
  }
</style>
