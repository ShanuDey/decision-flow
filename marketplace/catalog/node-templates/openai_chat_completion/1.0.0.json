{
  "schema_version": 1,
  "version": "1.0.0",
  "id": "openai_chat_completion",
  "name": "OpenAI: chat completion",
  "description": "Sends one prompt to an OpenAI chat model, using the connection's default model.",
  "icon": "sparkles",
  "docs_url": "https://platform.openai.com/docs/api-reference/chat/create",
  "tags": [
    "ai",
    "llm",
    "openai"
  ],
  "node_type": "http_request",
  "connection": {
    "type": "openai",
    "values": {}
  },
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "description": "What to ask"
    }
  ],
  "data": {
    "method": "POST",
    "url": "https://api.openai.com/v1/chat/completions",
    "body_type": "json",
    "body": {
      "model": "{{ connection.default_model }}",
      "messages": [
        {
          "role": "user",
          "content": "{{ input.prompt }}"
        }
      ]
    }
  }
}
